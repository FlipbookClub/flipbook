{
  "cli": {
    "version": ">= 19.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      // Explicit, like preview and production: these builds read the EAS
      // `development` environment. See docs/v2/environments.md for how that
      // environment does (and does not) reach a development build's code.
      "environment": "development",
      // S0-3: builds "Flipbook Dev" (com.flipbook.club.dev), which installs
      // beside the v1 app. Read by app.config.ts. Only the two development
      // profiles set this; preview and production must never.
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6778644424"
      },
      "android": {
        "track": "alpha"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6778644424"
      },
      "android": {
        // Not "production": Play rejects an API-created first release on a
        // track the app has never shipped to (Precondition check failed).
        // This app has only ever been distributed on testing tracks, so alpha
        // is where the Android testers actually are. Move to production once a
        // first production release exists and the Play Console declarations
        // (Data Safety, content rating, target audience) are complete.
        "track": "alpha",
        // Full release to the testing track, not a staged rollout: testers
        // are opted in, the group is small, and a 10% slice of it could reach
        // nobody. The native Android reader still has no real-hardware
        // verification, so reaching testers IS the verification. Re-introduce
        // a staged rollout when this profile moves to the production track.
        "releaseStatus": "completed"
      }
    }
  }
}
