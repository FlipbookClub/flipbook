{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Badge/**",
              "components/Banner/**",
              "components/BookCard/**",
              "components/Button/**",
              "components/ChatMessage/**",
              "components/Icon/**",
              "components/MarginReaction/**",
              "components/MemberProgress/**",
              "components/ReactionPicker/**",
              "components/SessionCard/**",
              "components/VoiceNote/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Literata|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Literata, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: kind, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:founding-host|author|pro|live|rec)$/]",
        "message": "<Badge> kind must be one of 'founding-host' | 'author' | 'pro' | 'live' | 'rec'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|actionLabel|onAction|toast|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: kind, children, actionLabel, onAction, toast, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:positive|warning|error)$/]",
        "message": "<Banner> kind must be one of 'positive' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|author|coverSrc|coverTone|price|wasPrice|includedWithPro|social|width|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BookCard> doesn't accept that prop. Declared props: title, author, coverSrc, coverTone, price, wasPrice, includedWithPro, social, width, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCard'] > JSXAttribute[name.name='coverTone'] > Literal[value!=/^(?:indigo|plum|gold|coral|aqua|ivory)$/]",
        "message": "<BookCard> coverTone must be one of 'indigo' | 'plum' | 'gold' | 'coral' | 'aqua' | 'ivory'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|author|src|tone|width|style|key|ref|className|style|children)$/]",
        "message": "<BookCover> doesn't accept that prop. Declared props: title, author, src, tone, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCover'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:indigo|plum|gold|coral|aqua|ivory)$/]",
        "message": "<BookCover> tone must be one of 'indigo' | 'plum' | 'gold' | 'coral' | 'aqua' | 'ivory'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|loading|disabled|pressed|focused|fullWidth|onClick|type|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, loading, disabled, pressed, focused, fullWidth, onClick, type, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm|pill)$/]",
        "message": "<Button> size must be one of 'md' | 'sm' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:sender|senderChapter|readerChapter|mine|quote|quoteChapter|removed|revealed|onReveal|onOpenQuote|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: sender, senderChapter, readerChapter, mine, quote, quoteChapter, removed, revealed, onReveal, onOpenQuote, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:listening|label|onJoin|joined|style|key|ref|className|style|children)$/]",
        "message": "<LiveBar> doesn't accept that prop. Declared props: listening, label, onJoin, joined, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarginAhead'] > JSXAttribute > JSXIdentifier[name!=/^(?:chapter|children|style|key|ref|className|style|children)$/]",
        "message": "<MarginAhead> doesn't accept that prop. Declared props: chapter, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarginReaction'] > JSXAttribute > JSXIdentifier[name!=/^(?:emoji|count|own|thread|replies|fresh|onClick|style|key|ref|className|style|children)$/]",
        "message": "<MarginReaction> doesn't accept that prop. Declared props: emoji, count, own, thread, replies, fresh, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Member'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|chapter|you|key|ref|className|style|children)$/]",
        "message": "<Member> doesn't accept that prop. Declared props: name, chapter, you."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReactionPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|onSelect|onComment|composing|style|key|ref|className|style|children)$/]",
        "message": "<ReactionPicker> doesn't accept that prop. Declared props: selected, onSelect, onComment, composing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReactionPicker'] > JSXAttribute[name.name='selected'] > Literal[value!=/^(?:♥|😂|😮|😢|🔥|🤔)$/]",
        "message": "<ReactionPicker> selected must be one of '♥' | '😂' | '😮' | '😢' | '🔥' | '🤔'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:when|day|title|coversChapter|going|host|readerChapter|rsvp|onRsvp|style|key|ref|className|style|children)$/]",
        "message": "<SessionCard> doesn't accept that prop. Declared props: when, day, title, coversChapter, going, host, readerChapter, rsvp, onRsvp, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:duration|elapsed|bars|recording|sender|senderChapter|readerChapter|mine|style|key|ref|className|style|children)$/]",
        "message": "<VoiceNote> doesn't accept that prop. Declared props: duration, elapsed, bars, recording, sender, senderChapter, readerChapter, mine, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
